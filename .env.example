APP_NAME=Invumo
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=invumo
DB_USERNAME=invumo_runtime
DB_PASSWORD=

DB_SCHEMA_HOST=127.0.0.1
DB_SCHEMA_PORT=5432
DB_SCHEMA_DATABASE=invumo
DB_SCHEMA_USERNAME=invumo_schema
DB_SCHEMA_PASSWORD=

POSTGRESQL_CLIENT_BIN_DIRECTORY=/usr/lib/postgresql/18/bin
POSTGRESQL_CLIENT_MAJOR_VERSION=18

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
COMPANY_ASSETS_DISK=company_assets_local
DOCUMENT_ARTIFACTS_DISK=document_artifacts_local
DOCUMENT_DELIVERY_MAX_RECIPIENTS=10
DOCUMENT_DELIVERY_COMPANY_RECIPIENTS_PER_HOUR=50
DOCUMENT_DELIVERY_COMPANY_RECIPIENTS_PER_DAY=250
DOCUMENT_DELIVERY_ACCOUNT_RECIPIENTS_PER_HOUR=100
DOCUMENT_DELIVERY_ACCOUNT_RECIPIENTS_PER_DAY=500
DOCUMENT_DELIVERY_PLATFORM_RECIPIENTS_PER_HOUR=1000
DOCUMENT_DELIVERY_PLATFORM_RECIPIENTS_PER_DAY=5000
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE_RETRY_AFTER=120
DB_TENANT_JOB_LOCK_CONNECTION=pgsql

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@invumo.com"
MAIL_FROM_NAME="${APP_NAME}"

ZEPTOMAIL_API_ENDPOINT=https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_SEND_API_TOKEN=
ZEPTOMAIL_WEBHOOK_SECRET=
ZEPTOMAIL_API_TIMEOUT=20
ZEPTOMAIL_API_CONNECT_TIMEOUT=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
